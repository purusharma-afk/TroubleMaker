{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "routes": [
    { "src": "^/$", "dest": "/api/site" },
    { "src": "^/index\\.html$", "dest": "/api/site" },
    { "handle": "filesystem" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15,
      "includeFiles": "public/index.html"
    }
  }
}
