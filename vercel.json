{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/api/site" },
    { "source": "/index.html", "destination": "/api/site" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15,
      "includeFiles": "public/index.html"
    }
  }
}
